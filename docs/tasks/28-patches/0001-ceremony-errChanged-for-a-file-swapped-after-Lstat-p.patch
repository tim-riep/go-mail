+// setNofile sets the soft RLIMIT_NOFILE to cur, the hard one stays max.
+func setNofile(cur, max uint64) error {
+	return syscall.Setrlimit(syscall.RLIMIT_NOFILE, &syscall.Rlimit{Cur: cur, Max: max})
+}
