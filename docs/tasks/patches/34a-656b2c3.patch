+			t.Fatalf("message\n%q, want\n%q", err.Error(), want)
+		}
+		if fi, err := os.Lstat(le.Old); err != nil || !fi.IsDir() {
+			t.Fatalf("the directory under %s: %v %v", le.Old, fi, err)
+		}
+	})
+}
