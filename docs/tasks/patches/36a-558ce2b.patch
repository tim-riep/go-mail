+//     process can know before the rename puts it there: it has to see
+//     the new name (by listing or watching the directory) and act inside
+//     this window, while the temporary name is there from the open on.
+//     The window is narrower than the one between a Root.Lstat of the
+//     temporary name and its unlink (the directory is opened for the
+//     unlink before the Root.Lstat, openDirIn), but it is not closed;
+//   - the rename replaces an entry that another process put under aside
+//     before it (a directory makes os.Root refuse it): that process would
+//     have to guess 64 random bits. renameat2(2) with RENAME_NOREPLACE is
+//     not in package syscall.
+func (w *written) dropTemp(root *os.Root) error {
+	aside, err := newTempName()
+	if err != nil {
+		return err
+	}
+	if err := root.Rename(w.tmp, aside); err != nil {
+		if errors.Is(err, fs.ErrNotExist) {
+			return meanwhileErr(root, w.tmp, "missing", "")
+		}
+		if what := w.differs(root, w.tmp); what != "" {
+			return meanwhileErr(root, w.tmp, what, "")
+		}
+		return pathErrIn(root, aside, err)
+	}
+	// The directory is opened before the Root.Lstat, so that the window
+	// up to the unlink holds no open (Linux and AIX; elsewhere d is nil,
+	// and an error leaves it nil: removeNameIn opens it then and reports
+	// the error).
+	d, _ := openDirIn(root)
+	if d != nil {
+		defer d.Close()
+	}
+	if what := w.differs(root, aside); what != "" {
+		return asideErr(root, w.tmp, aside, what)
+	}
+	callTempInHook(root, aside, "unlink")
+	if err := removeNameInDir(root, d, aside); err != nil {
+		switch {
+		case errors.Is(err, fs.ErrNotExist):
+			// Gone between the Root.Lstat and the unlink: removed or
+			// renamed by another process.
+			return asideErr(root, w.tmp, aside, "missing")
+		case isDirErr(err):
+			// A directory put under aside in that window; it stays.
+			return asideErr(root, w.tmp, aside, "not a regular file")
+		}
+		return err
+	}
+	return nil
+}
